<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- The Kafka client is chatty at INFO: it dumps its full config on every
         start. WARN keeps the lab output readable; raise it to INFO when you
         want to see which settings actually arrived. -->
    <logger name="org.apache.kafka" level="WARN"/>
    <!-- Names only the deserializer classes when a record cannot be read. The
         exception that follows says which record it was. -->
    <logger name="org.apache.kafka.clients.consumer.internals.CompletedFetch" level="OFF"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
